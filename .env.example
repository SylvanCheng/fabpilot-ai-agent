# Copy to .env and adjust. .env is git-ignored; never commit real secrets.

APP_ENV=dev
LOG_LEVEL=INFO

# --- PostgreSQL (used by docker compose to create roles on first start) ---
POSTGRES_PASSWORD=change-me-postgres
FAB_LOADER_PASSWORD=change-me-loader
FAB_READER_PASSWORD=change-me-reader
FABPILOT_APP_PASSWORD=change-me-app

# --- Backend DB URLs when running the API on the host (`uv run uvicorn ...`) ---
# In docker compose these are overridden to point at the `postgres` service.
BUSINESS_DB_URL=postgresql+psycopg://fab_reader:change-me-reader@localhost:5432/fab_business
APP_DB_URL=postgresql+psycopg://fabpilot_app:change-me-app@localhost:5432/fabpilot_app
FAB_LOADER_DSN=postgresql://fab_loader:change-me-loader@localhost:5432/fab_business

# --- LLM: any OpenAI-compatible endpoint, switched here and nowhere else ---
# Dev (Ollama on a rented GPU box, e.g. via SSH tunnel `ssh -L 11434:localhost:11434 gpu-box`):
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
LLM_API_KEY=not-needed-for-ollama
# Prod (vLLM):
# LLM_PROVIDER=vllm
# LLM_BASE_URL=http://<gpu-host>:8000/v1
# LLM_MODEL=Qwen/Qwen3-8B
# LLM_API_KEY=<token configured with vllm --api-key>
LLM_TIMEOUT_S=60

CORS_ORIGINS=http://localhost:5080
