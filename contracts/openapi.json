{
  "components": {
    "schemas": {
      "CheckOut": {
        "properties": {
          "detail": {
            "additionalProperties": true,
            "default": {},
            "title": "Detail",
            "type": "object"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "latency_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latency Ms"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "title": "CheckOut",
        "type": "object"
      },
      "FabOverviewOut": {
        "properties": {
          "equipment_count": {
            "title": "Equipment Count",
            "type": "integer"
          },
          "first_lot_start": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Lot Start"
          },
          "last_lot_start": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Lot Start"
          },
          "lot_count": {
            "title": "Lot Count",
            "type": "integer"
          },
          "lots_by_status": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "Lots By Status",
            "type": "object"
          },
          "wafer_count": {
            "title": "Wafer Count",
            "type": "integer"
          }
        },
        "required": [
          "lot_count",
          "lots_by_status",
          "wafer_count",
          "equipment_count",
          "first_lot_start",
          "last_lot_start"
        ],
        "title": "FabOverviewOut",
        "type": "object"
      },
      "LivenessOut": {
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "default": "0.1.0",
            "title": "Version",
            "type": "string"
          }
        },
        "title": "LivenessOut",
        "type": "object"
      },
      "ReadinessOut": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "$ref": "#/components/schemas/CheckOut"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          },
          "version": {
            "default": "0.1.0",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadinessOut",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Self-hosted LLM agent for industrial process & quality data.",
    "title": "FabPilot API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/fab/overview": {
      "get": {
        "operationId": "overview_api_v1_fab_overview_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FabOverviewOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Size of the fab dataset",
        "tags": [
          "fab data"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "liveness_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "readiness_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessOut"
                }
              }
            },
            "description": "One or more checks failed"
          }
        },
        "summary": "Readiness",
        "tags": [
          "health"
        ]
      }
    }
  }
}
